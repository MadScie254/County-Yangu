# Secrets for the Edge Functions of ONE county. Copy to supabase/.env (gitignored) and push with:
#     supabase secrets set --env-file supabase/.env
# SUPABASE_URL and the project's API keys are provided to functions by Supabase itself.
# To switch off the legacy JWT keys (anon, service_role), create a secret key (sb_secret_...) under Project Settings >
# API Keys and set it here; functions prefer it over the legacy service_role key.
COUNTY_SERVICE_KEY=
# Never put any of these in a VITE_ variable: those are shipped to every visitor's browser.

# ---- required for anything to work --------------------------------------------------------------------------------
COUNTY_NAME=Nairobi
# 32+ random characters. Keys the phone, voter and token hashes. Do NOT change it during a voting round:
# every voter hash would change and people could vote again.   openssl rand -base64 48
COUNTY_HMAC_SECRET=
# Shared secret for the scheduled jobs (pg_cron sends it in x-cron-secret).   openssl rand -base64 32
CRON_SECRET=
# Where the app and the console are served. Production: set both. Comma separated origins, no trailing slash.
ALLOWED_ORIGINS=https://yangu.example,https://console.example
CONSOLE_URL=https://console.example

# ---- SMS (Africa's Talking). Unset = a mock that logs nothing but the number of characters ------------------------------
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Secret tokens in the callback URLs you give Africa's Talking (…/ussd-gateway?token=…, …/sms-inbound?token=…)
USSD_CALLBACK_TOKEN=
SMS_CALLBACK_TOKEN=
# Optional: only accept callbacks from these addresses (comma separated)
AT_ALLOWED_IPS=
# Supabase Auth "Send SMS" hook secret (v1,whsec_…) for County Assembly members who sign in by phone
SEND_SMS_HOOK_SECRET=

# ---- Email (Resend). Unset = messages are logged as sent but go nowhere ----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=CountyConnect <noreply@your-domain>

# ---- M-Pesa (Safaricom Daraja) --------------------------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Secret token in the callback URLs (pay-callback / pay-c2b). 32+ random characters.
MPESA_CALLBACK_TOKEN=
# Optional: Safaricom's callback source addresses, comma separated
MPESA_ALLOWED_IPS=

# ---- AI (staff assistant). Unset = a labelled mock answer ---------------------------------------------------------------------
# AI_PROVIDER=cloudflare | anthropic | mock   (default: whichever has credentials)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Approximate price per million tokens in KES, used only for the monthly cap
# AI_KES_PER_MTOK_IN=
# AI_KES_PER_MTOK_OUT=

# ---- Optional tuning ------------------------------------------------------------------------------------------------------
# OTP_GLOBAL_PER_HOUR=300
# AUDITOR_ACCESS_DAYS=30
# KRA_MODE=live        (only once GavaConnect credentials exist and the lookup in _shared/kra.ts is completed)
# MOCK_LOG_BODY=true   (development only: print the text of mock SMS/email, including codes and links)
